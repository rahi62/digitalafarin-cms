# Backend
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://seocms:seocms@postgres:5432/seocms
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_SITE_DOMAIN=localhost:3001

# Admin frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/cms/v1

# Public Next.js server (API and media may use different internal services)
DIGITALAFARIN_CMS_URL=http://localhost:8000/api/cms/v1
DIGITALAFARIN_CMS_SITE=localhost:3001
DIGITALAFARIN_CMS_MEDIA_UPSTREAM=http://localhost:8000/media/
# Read these into Django settings explicitly; use a public CDN URL for a separate admin origin.
DIGITALAFARIN_CMS_MEDIA_PUBLIC_URL=/media/
DIGITALAFARIN_CMS_MEDIA_LEGACY_ORIGINS=
