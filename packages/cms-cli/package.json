{
  "name": "@digitalafarin/cms-cli",
  "version": "0.2.0",
  "description": "Installer/wiring CLI for DigitalAfarin CMS in Django + Next.js projects",
  "type": "module",
  "bin": {
    "digitalafarin-cms": "./bin/cli.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
