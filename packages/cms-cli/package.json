    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalafarin/digitalafarin-cms.git",
    "directory": "packages/cms-cli"
  },
  "homepage": "https://github.com/digitalafarin/digitalafarin-cms",
  "bugs": {
    "url": "https://github.com/digitalafarin/digitalafarin-cms/issues"
  },
  "author": "DigitalAfarin",
  "keywords": [
    "digitalafarin",
    "cms",
    "headless",
    "seo"
